suite MONAN_DEV
   defstatus suspended

   edit ECF_HOME "/mnt/beegfs/monan/DEV/MONAN-WorkFlow/ecflow"
   edit ECF_HOST "egeon-login.cptec.inpe.br"
   edit ECF_INCLUDE "/mnt/beegfs/monan/DEV/MONAN-WorkFlow/ecflow/includes"
   edit ECF_TRIES "1"

   family GCC_STAB
      cron 06:00
      
      edit EXP "GFS"
      edit RES "1024002"
      edit FCSTH "24"

      task pre
         label Info "pre-processing MONAN - script 2.run_pre.bash of scripts_CD-CT"
         label date "YYYYMMDDHH"
         label VERSION "Version of Model"
      
      task model
         trigger /MONAN_DEV/GCC_STAB/pre eq complete
         label Info "model MONAN - script 3.run_model.bash of scripts_CD-CT"
         label date "YYYYMMDDHH"
         label VERSION "Version of Model"
      
      task post
         trigger /MONAN_DEV/GCC_STAB/model eq complete
         label Info "post-processing MONAN - script 4.run_post.bash of scripts_CD-CT"
         label date "YYYYMMDDHH"
         label VERSION "Version of Model"
         event done_post_stab

      family products
         task sanity_check
            trigger /MONAN_DEV/GCC_STAB/post eq complete
            label Info "sanity_check - MONAN-Products"
            label date "YYYYMMDDHH"
            label VERSION "Version of Model"
      endfamily       

   endfamily

   family GCC_DEV
      cron 18:00
      
      edit EXP "GFS"
      edit RES "1024002"
      edit FCSTH "24"

      task compile
         label Info "compile and install MONAN - script clone_MONAN-scripts_CDCT.bash"
         label date "YYYYMMDDHH"
         label VERSION "Version of Model"
         
      task pre
         trigger /MONAN_DEV/GCC_DEV/compile eq complete
         label Info "pre-processing MONAN - script 2.run_pre.bash of scripts_CD-CT"
         label date "YYYYMMDDHH"
         label VERSION "Version of Model"
      
      task model
         trigger /MONAN_DEV/GCC_DEV/pre eq complete
         label Info "model MONAN - script 3.run_model.bash of scripts_CD-CT"
         label date "YYYYMMDDHH"
         label VERSION "Version of Model"
      
     task post
         trigger /MONAN_DEV/GCC_DEV/model eq complete
         label Info "post-processing MONAN - script 4.run_post.bash of scripts_CD-CT"
         label date "YYYYMMDDHH"
         label VERSION "Version of Model"
         event done_post_dev

      family products
         task sanity_check
            trigger /MONAN_DEV/GCC_DEV/post eq complete
            label Info "sanity_check - MONAN-Products"
            label date "YYYYMMDDHH"
            label VERSION "Version of Model"
      endfamily

   endfamily

   family GCC_PRODUCTS
      edit EXP "GFS"
      edit RES "1024002"
      edit FCSTH "24"
          
      task compare_stab_dev
         trigger /MONAN_DEV/GCC_DEV/post:done_post_dev
         label Info "compare stab and dev - MONAN-Products"
         label date "YYYYMMDDHH"
         label VERSION "Version of Model"

   endfamily

endsuite
