%include <head_DEV.h>
      
#-----------------------------------------------------------------------------#
# !SCRIPT: run_post
#
# !DESCRIPTION:
#     Script to run post-processing of MONAN model .
#     
#-----------------------------------------------------------------------------#


# Standart directories variables:---------------------------------------
#DIRHOMES=%ECF_HOME%/%SUITE%/%FAMILY%/MONAN-Products;  mkdir -p ${DIRHOMES}  
#DIRHOMED=%ECF_HOME%/%SUITE%/%FAMILY%/MONAN-Products;  mkdir -p ${DIRHOMED}  
#SCRIPTS=${DIRHOMES}/scripts;                                      mkdir -p ${SCRIPTS}
#DATAIN=${DIRHOMED}/datain;                                        #mkdir -p ${DATAIN}
#DATAOUT=${DIRHOMED}/dataout;                                      #mkdir -p ${DATAOUT}
#SOURCES=${DIRHOMES}/sources;                                      #mkdir -p ${SOURCES}
#EXECS=${DIRHOMED}/execs;                                          #mkdir -p ${EXECS}
#----------------------------------------------------------------------


# Input variables:--------------------------------------
EXP=%EXP%
RES=%RES%
YYYYMMDDHHi=%YYYY%%MM%%DD%00
FCST=%FCSTH%
#export FAMILY1=%FAMILY1%
#-------------------------------------------------------


# Local variables:--------------------------------------
DIRSCRIPTSCDCT=${DIRSUITE}/MONAN_DEV/GCC_DEV/scripts_CD-CT
#DIRBEEGFSPOST=/mnt/beegfs/monan/tc
#-------------------------------------------------------



MVERSION=$(cat ${DIRSCRIPTSCDCT}/execs/VERSION.txt)
ecflow_client --label=Info "Running  4.run_model.bash"
ecflow_client --label=date "${YYYYMMDDHHi}"
ecflow_client --label=VERSION "${MVERSION}"
# Run the 4.run_model.bash script from scripts_CDCT oficial repo:----------
cd ${DIRSCRIPTSCDCT}/scripts
${DIRSCRIPTSCDCT}/scripts/4.run_post.bash ${EXP} ${RES} ${YYYYMMDDHHi} ${FCST}
#-------------------------------------------------------
sleep 5


#CR: criando diretorio oficial final:
#mkdir -p ${DIRBEEGFSPOST}/${MVERSION}/${FAMILY1}/${YYYYMMDDHHi}/

# copy post:
#cp -fr ${DIRSCRIPTSCDCT}/dataout/${YYYYMMDDHHi}/Post ${DIRBEEGFSPOST}/${MVERSION}/${FAMILY1}/${YYYYMMDDHHi}/

# And remove them from the original output diretory dataout:
#rm -fr ${DIRSCRIPTSCDCT}/dataout/${YYYYMMDDHHi}/Model
#rm -fr ${DIRSCRIPTSCDCT}/dataout/${YYYYMMDDHHi}/Post
#rm -fr ${DIRSCRIPTSCDCT}/datain/${YYYYMMDDHHi}

# requeue a task dos produtos e ativação evento done para ativar o trigger (sleep para dar tempo antes de requeue automatico devido ao cron)
ecflow_client --requeue /MONAN_DEV/GCC_PRODUCTS/sanity_check_dev
ecflow_client --requeue /MONAN_DEV/GCC_PRODUCTS/compare_stab_dev
sleep 5
ecflow_client --event done_post_dev set
sleep 5
%include <tail.h>

# file is served by ecflow-server
