%include <head_DEV.h>
      
#-----------------------------------------------------------------------------#
# !SCRIPT: compare_stab_dev
#
# !DESCRIPTION:
#     Script to run compare_dev_stable of MONAN-Products.
#     
#-----------------------------------------------------------------------------#


# Standart directories variables:---------------------------------------
#DIRHOMES=%ECF_HOME%/%SUITE%/%FAMILY%/MONAN-Products;  mkdir -p ${DIRHOMES}  
#DIRHOMED=%ECF_HOME%/%SUITE%/%FAMILY%/MONAN-Products;  mkdir -p ${DIRHOMED}  
#SCRIPTS=${DIRHOMES}/scripts;                                      mkdir -p ${SCRIPTS}
#DATAIN=${DIRHOMED}/datain;                                        #mkdir -p ${DATAIN}
#DATAOUT=${DIRHOMED}/dataout;                                      #mkdir -p ${DATAOUT}
#SOURCES=${DIRHOMES}/sources;                                      #mkdir -p ${SOURCES}
#EXECS=${DIRHOMED}/execs;                                          #mkdir -p ${EXECS}
#----------------------------------------------------------------------


# Input variables:--------------------------------------
EXP=%EXP%
RES=%RES%
YYYYMMDDHHi=%YYYY%%MM%%DD%00
FCST=%FCSTH%
#-------------------------------------------------------


# Local variables:--------------------------------------
DIRSCRIPTSCDCT_STAB=${DIRSUITE}/MONAN_DEV/GCC_STAB/scripts_CD-CT
DIRSCRIPTSCDCT_DEV=${DIRSUITE}/MONAN_DEV/GCC_DEV/scripts_CD-CT
DIRMONANPRODUCTS=${DIRSUITE}/MONAN_DEV/GCC_PRODUCTS/MONAN-Products
TYPERUN="compare_stab_dev"
#-------------------------------------------------------


MVERSION_STAB=$(cat ${DIRSCRIPTSCDCT_STAB}/execs/VERSION.txt)
MVERSION_DEV=$(cat ${DIRSCRIPTSCDCT_DEV}/execs/VERSION.txt)
ecflow_client --label=Info "Running  6.run_compare_dev_stable.bash"
ecflow_client --label=date "${YYYYMMDDHHi}"
ecflow_client --label=VERSION "Stab: ${MVERSION_STAB} - Dev: ${MVERSION_DEV}"
# Run the 6.run_compare_dev_stable.bash oficial repo:----------
cd ${DIRMONANPRODUCTS}/scripts
${DIRMONANPRODUCTS}/scripts/6.run_compare_dev_stable.bash ${EXP} ${RES} ${YYYYMMDDHHi} ${FCST} ${DIRSCRIPTSCDCT_STAB} ${DIRSCRIPTSCDCT_DEV} ${TYPERUN}
#-------------------------------------------------------

# altera o evento do post_stab para clear novamente
ecflow_client --alter change event done_post_dev clear /MONAN_DEV/GCC_DEV/post

%include <tail.h>
# file is served by ecflow-server
