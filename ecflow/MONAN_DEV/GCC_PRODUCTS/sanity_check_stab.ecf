%include <head_DEV.h>
      
#-----------------------------------------------------------------------------#
# !SCRIPT: sanity_check_stab
#
# !DESCRIPTION:
#     Script to run sanity_check_stab of MONAN-Products.
#     
#-----------------------------------------------------------------------------#


# Standart directories variables:---------------------------------------
#DIRHOMES=%ECF_HOME%/%SUITE%/%FAMILY%/MONAN-Products;  mkdir -p ${DIRHOMES}  
#DIRHOMED=%ECF_HOME%/%SUITE%/%FAMILY%/MONAN-Products;  mkdir -p ${DIRHOMED}  
#SCRIPTS=${DIRHOMES}/scripts;                                      mkdir -p ${SCRIPTS}
#DATAIN=${DIRHOMED}/datain;                                        #mkdir -p ${DATAIN}
#DATAOUT=${DIRHOMED}/dataout;                                      #mkdir -p ${DATAOUT}
#SOURCES=${DIRHOMES}/sources;                                      #mkdir -p ${SOURCES}
#EXECS=${DIRHOMED}/execs;                                          #mkdir -p ${EXECS}
#----------------------------------------------------------------------


# Input variables:--------------------------------------
EXP=%EXP%
RES=%RES%
YYYYMMDDHHi=%YYYY%%MM%%DD%00
FCST=%FCSTH%
#-------------------------------------------------------


# Local variables:--------------------------------------
DIRSCRIPTSCDCT=${DIRSUITE}/MONAN_DEV/GCC_STAB/scripts_CD-CT
DIRMONANPRODUCTS=${DIRSUITE}/MONAN_DEV/GCC_PRODUCTS/MONAN-Products
TYPERUN="sanity_stab"
#-------------------------------------------------------


MVERSION=$(cat ${DIRSCRIPTSCDCT}/execs/VERSION.txt)
ecflow_client --label=Info "Running  5.run_sanity_check.bash to GCC_STAB"
ecflow_client --label=date "${YYYYMMDDHHi}"
ecflow_client --label=VERSION "${MVERSION}"
# Run the 5.run_sanity_check.bash oficial repo:----------
cd ${DIRMONANPRODUCTS}/scripts
${DIRMONANPRODUCTS}/scripts/5.run_sanity_check.bash ${EXP} ${RES} ${YYYYMMDDHHi} ${FCST} ${DIRSCRIPTSCDCT} ${TYPERUN}
#-------------------------------------------------------

# altera o evento do post_stab para clear novamente
ecflow_client --alter change event done_post_stab clear /MONAN_DEV/GCC_STAB/post

%include <tail.h>
# file is served by ecflow-server
