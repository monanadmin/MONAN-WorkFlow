%include <head.h>
      
#-----------------------------------------------------------------------------#
# !SCRIPT: run_poducts
#
# !DESCRIPTION:
#     Script to run the products of pos-processing of MONAN model .
#     
#-----------------------------------------------------------------------------#


# Standart directories variables:---------------------------------------
#DIRHOMES=%ECF_HOME%/%SUITE%/%FAMILY%/MONAN-Products;  mkdir -p ${DIRHOMES}  
#DIRHOMED=%ECF_HOME%/%SUITE%/%FAMILY%/MONAN-Products;  mkdir -p ${DIRHOMED}  
#SCRIPTS=${DIRHOMES}/scripts;                                      mkdir -p ${SCRIPTS}
#DATAIN=${DIRHOMED}/datain;                                        #mkdir -p ${DATAIN}
#DATAOUT=${DIRHOMED}/dataout;                                      #mkdir -p ${DATAOUT}
#SOURCES=${DIRHOMES}/sources;                                      #mkdir -p ${SOURCES}
#EXECS=${DIRHOMED}/execs;                                          #mkdir -p ${EXECS}
#----------------------------------------------------------------------


# Input variables:--------------------------------------
EXP=%EXP%
RES=%RES%
YYYYMMDDHHi=2024010100
FCST=%FCSTH%
export FAMILY1=%FAMILY1%
NNODES=%NNODES%
NCPN=64
NCORES=$(echo "${NNODES}*${NCPN}" | bc )
NTIME=%NTIME%
FILA=%FILA%
#-------------------------------------------------------
ecflow_client --label=date "${YYYYMMDDHHi}"
ecflow_client --label=ExpInfo "NNODES: ${NNODES} NCORES: ${NCORES} NCPN: ${NCPN} NTIME: ${NTIME}"


# Local variables:--------------------------------------
DIRSCRIPTSCDCT=${DIRSUITE}/${SUITE}/GCC_PEE/scripts_CD-CT
DIRBEEGFSPEE=/mnt/beegfs/monan/PEE
MVERSION=$(cat ${DIRSCRIPTSCDCT}/execs/MONAN-VERSION.txt)
CMPASVERSION=$(cat ${DIRSCRIPTSCDCT}/execs/CONVMPAS-VERSION.txt)
SCDCTVERSION=$(cat ${DIRSCRIPTSCDCT}/VERSION.txt)
#-------------------------------------------------------



ecflow_client --label=Info "Running  4.run_model.bash"
ecflow_client --label=VERSION "ScDCT:${SCDCTVERSION} / ConvMPAS:${CMPASVERSION}"
# Run the 4.run_model.bash script from scripts_CDCT oficial repo:----------
cd ${DIRSCRIPTSCDCT}/scripts
${DIRSCRIPTSCDCT}/scripts/4.run_post.bash ${EXP} ${RES} ${YYYYMMDDHHi} ${FCST}
#-------------------------------------------------------
sleep 5


#CR: criando diretorio PEE:
mkdir -p ${DIRBEEGFSPEE}/${MVERSION}

# copy logs:
cp -f ${DIRSCRIPTSCDCT}/dataout/${YYYYMMDDHHi}/Post/logs/log.atmosphere.0000.out ${DIRBEEGFSPEE}/${MVERSION}/log.atmosphere.0000.out.${NNODES}n-${NCORES}c-${NCPN}cpn-${NTIME}
cp -f ${DIRSCRIPTSCDCT}/dataout/${YYYYMMDDHHi}/Post/logs/model.bash ${DIRBEEGFSPEE}/${MVERSION}/model.bash.${NNODES}n-${NCORES}c-${NCPN}cpn-${NTIME}

# And remove them from the original output diretory dataout:
rm -fr ${DIRSCRIPTSCDCT}/dataout/${YYYYMMDDHHi}/Model
rm -fr ${DIRSCRIPTSCDCT}/dataout/${YYYYMMDDHHi}/Post
rm -fr ${DIRSCRIPTSCDCT}/datain/${YYYYMMDDHHi}


%include <tail.h>
# file is served by ecflow-server
